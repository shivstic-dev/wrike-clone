# Backend / Railway
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DB_SSL=true
DB_MAX_CONNECTIONS=1
DB_IDLE_TIMEOUT_MS=1000
DB_APP_ROLE=openwork_app

# Generate each secret independently. Never commit real values.
JWT_SECRET=generate-at-least-32-random-bytes
ENCRYPTION_KEY=generate-at-least-32-random-bytes
SETUP_KEY=generate-at-least-24-random-bytes
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
JWT_ISSUER=openwork-api
JWT_AUDIENCE=openwork-web

CORS_ORIGINS=https://wrike-clone-three.vercel.app
APP_PUBLIC_URL=https://wrike-clone-three.vercel.app
ALLOW_PUBLIC_REGISTRATION=false

# Private Supabase Storage; service role is backend-only.
SUPABASE_URL=https://lsjeobyrmxiqewehhjai.supabase.co
SUPABASE_SERVICE_ROLE_KEY=copy-from-supabase-project-api-settings
SUPABASE_STORAGE_BUCKET=work-management-files

# Required email delivery and task-alert scheduler
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_SECURE=false
EMAIL_FROM=OpenWork Hub <tasks@example.com>
NOTIFICATION_CRON="0 */15 * * * *"
DEADLINE_ALERT_HOURS=48,24,0

# Optional integrations
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
SENTRY_DSN=

# Frontend / Vercel
VITE_API_URL=https://wrike-clone-production-9894.up.railway.app/api/v1
VITE_SENTRY_DSN=
