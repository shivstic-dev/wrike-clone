{
  "name": "@wrike-clone/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "npx nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "migration:run": "knex migrate:latest --knexfile src/database/knexfile.ts",
    "migration:rollback": "knex migrate:rollback --knexfile src/database/knexfile.ts",
    "migration:make": "knex migrate:make --knexfile src/database/knexfile.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/cqrs": "^11.0.0",
    "@wrike-clone/shared": "*",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0",
    "bullmq": "^5.40.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "zod": "^3.24.0",
    "helmet": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "compression": "^1.7.4",
    "minio": "^8.0.2",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "nodemailer": "^6.9.0",
    "socket.io": "^4.8.0",
    "graphql": "^16.9.0",
    "@apollo/server": "^4.11.0",
    "bcrypt": "^5.1.1",
    "typescript": "^5.7.0",
    "@nestjs/cli": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/uuid": "^10.0.0",
    "@types/compression": "^1.7.5",
    "@types/bcrypt": "^5.0.2",
    "@types/nodemailer": "^6.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["src/**/*.(t|j)s", "!src/main.ts"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
