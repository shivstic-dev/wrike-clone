# ──────────────────────────────────────────────
# Wrike Clone — Environment Configuration
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
APP_NAME=wrike-clone
APP_PORT=4000
API_PREFIX=/api/v1
APP_PUBLIC_URL=https://app.example.invalid

# Database (PostgreSQL)
DATABASE_URL=postgresql://app:change_me@pooler.example.invalid:6543/postgres
MIGRATE_DATABASE_URL=postgresql://migrator:change_me@db.example.invalid:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wrike_clone
DB_USER=wrike
DB_PASSWORD=wrike_dev_password_change_in_prod
DB_SSL=true
DB_MAX_CONNECTIONS=25
DB_IDLE_TIMEOUT_MS=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth (Keycloak)
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters_long
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=wrike-clone
KEYCLOAK_CLIENT_ID=wrike-api
KEYCLOAK_CLIENT_SECRET=change_in_production

# Object Storage (MinIO/S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wrike_access_key
S3_SECRET_KEY=wrike_secret_key_change_in_prod
S3_BUCKET=wrike-files
S3_USE_SSL=false

# Search (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change_in_production

# Encryption
ENCRYPTION_KEY=change_this_to_a_64_hex_char_key_in_production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ── Error Monitoring (Sentry) ──────────────
# Get a free DSN at https://sentry.io
SENTRY_DSN=https://your-dsn-here.ingest.sentry.io/1234567

# Frontend uses VITE_SENTRY_DSN (Vite exposes VITE_* vars to client)
VITE_SENTRY_DSN=https://your-dsn-here.ingest.sentry.io/1234567

# ── Email (SMTP) ──────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_SECURE=false
# Set SMTP_SECURE=true to use TLS (SMTPS), false for STARTTLS (port 587)
EMAIL_FROM=noreply@wrikeclone.app

# ── AI Copilot (OpenAI) ───────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Auth Overrides ────────────────────────
# Set DEFAULT_TENANT_SLUG for single-tenant mode (skip tenant slug on login)
DEFAULT_TENANT_SLUG=
# Set ALLOW_PUBLIC_REGISTRATION=true to allow anyone to register
ALLOW_PUBLIC_REGISTRATION=false
SETUP_KEY=dev-setup-key

# ── File Uploads ──────────────────────────
STORAGE_DRIVER=local
