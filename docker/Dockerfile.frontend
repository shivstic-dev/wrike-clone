# ──────────────────────────────────────────────
# Wrike Clone — Frontend Dockerfile
# Multi-stage: build -> nginx
# ──────────────────────────────────────────────

# Stage 1: Build
# ──────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/frontend/package.json packages/frontend/package.json

# Install dependencies (workspace root install)
RUN npm ci --include-workspace-root --no-audit --no-fund

# Copy source code
COPY tsconfig.base.json ./
COPY packages/shared/tsconfig.json packages/shared/tsconfig.json
COPY packages/shared/src packages/shared/src
COPY packages/frontend/tsconfig.json packages/frontend/tsconfig.json
COPY packages/frontend/ packages/frontend/

# Build the shared workspace before the frontend that imports it
RUN npm run build -w packages/shared
RUN npm run build -w packages/frontend

# ──────────────────────────────────────────────
# Stage 2: Nginx
# ──────────────────────────────────────────────
FROM nginx:alpine AS production

# Install curl for health check
RUN apk add --no-cache curl

# Copy custom nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/packages/frontend/dist /usr/share/nginx/html

# Create non-root user (nginx image uses 'nginx' user by default)
RUN chown -R nginx:nginx /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:80/healthz.html || curl -f http://localhost:80 || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
